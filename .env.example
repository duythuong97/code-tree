# Copy thành .env trên từng máy. Chỉ sửa giá trị cần thiết.

# Đường dẫn dùng bởi demo-config.json. Nên dùng absolute path ở môi trường thật.
CODE_MAP_DEMO_ROOT=./sample-source
CODE_TREE_OUTPUT=./.artifacts/code-tree/demo
CODE_MAP_INPUT_DATA=./input-data
CODE_TREE_CATALOG=./examples/v3/catalog

# Không bắt buộc khi executable đã có trong PATH.
# macOS/Linux example: /usr/local/share/dotnet/dotnet
# Windows example: C:\Program Files\dotnet\dotnet.exe
CODE_TREE_DOTNET=

# macOS/Linux example: /usr/local/bin/node
# Windows example: C:\Program Files\nodejs\node.exe
CODE_TREE_NODE=
